      "node": ">=22.19.0"
    }
  },
  "npmPackages": [
    {"package": "@narumitw/pi-caffeinate", "version": "0.49.4"},
    {"package": "pi-btw", "version": "0.4.1"},
    {"package": "@narumitw/pi-goal", "version": "0.54.4"},
    {"package": "pi-cursor-sdk", "version": "0.3.6"}
  ]
}
